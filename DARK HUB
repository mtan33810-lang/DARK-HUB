--============================================================

AutomaticallyTab:CreateSection("Main Controls")

AutomaticallyTab:CreateToggle({
    Name = "Auto Collect ALL Plants",
    CurrentValue = false,
    Flag = "AutoCollectAll",

    Callback = function(Value)
        if Value then
            setAutoCollect(true, true)

            Rayfield:Notify({
                Title = "Auto Collect",
                Content = "Collecting nearby plants.",
                Duration = 3
            })
        else
            AutoCollectAll = false
            stopAutoCollect()

            Rayfield:Notify({
                Title = "Auto Collect",
                Content = "Stopped.",
                Duration = 2
            })
        end
    end
})

--============================================================
-- MUTATION FILTER
--============================================================

AutomaticallyTab:CreateSection("Mutation Filter")

AutomaticallyTab:CreateToggle({
    Name = "Mutation Plants Only",
    CurrentValue = false,
    Flag = "MutationOnly",

    Callback = function(Value)
        MutationOnly = Value
    end
})

local MutationDropdown

AutomaticallyTab:CreateInput({
    Name = "Search Mutation",
    PlaceholderText = "Example: Golden",
    RemoveTextAfterFocusLost = false,

    Callback = function(Text)
        if Text == "" then
            return
        end

        local Search = Text:lower()
        local Found = {}

        for _, Mutation in ipairs(ALL_MUTATIONS) do
            if Mutation:lower():find(
                Search,
                1,
                true
            ) then
                table.insert(
                    Found,
                    Mutation
                )
            end
        end

        if #Found == 0 then
            Rayfield:Notify({
                Title = "Mutation Search",
                Content = "No mutation found.",
                Duration = 2
            })

            return
        end

        for _, Mutation in ipairs(Found) do
            addSelection(
                SelectedMutations,
                Mutation
            )
        end

        if MutationDropdown then
            MutationDropdown:Set(
                SelectedMutations
            )
        end

        Rayfield:Notify({
            Title = "Mutation Added",
            Content = table.concat(
                Found,
                ", "
            ),
            Duration = 2
        })
    end
})

MutationDropdown = AutomaticallyTab:CreateDropdown({
    Name = "Select Mutations",
    Options = ALL_MUTATIONS,
    CurrentOption = {},
    MultipleOptions = true,
    Flag = "SelectedMutations",

    Callback = function(Options)
        SelectedMutations =
            convertSelection(Options)
    end
})

