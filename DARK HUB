--============================================================
-- SELECTION HELPERS
--============================================================

local function contains(List, Value)
    for _, Item in ipairs(List) do
        if Item == Value then
            return true
        end
    end

    return false
end

local function addSelection(List, Value)
    if not contains(List, Value) then
        table.insert(List, Value)
    end
end

local function convertSelection(Value)
    local Result = {}

    if typeof(Value) == "string" then
        table.insert(Result, Value)
        return Result
    end

    if typeof(Value) ~= "table" then
        return Result
    end

    for Key, Item in pairs(Value) do
        if typeof(Item) == "string" then
            table.insert(Result, Item)

        elseif Item == true and typeof(Key) == "string" then
            table.insert(Result, Key)
        end
    end

    return Result
end

--============================================================
-- MATCHING
--============================================================

local function matchesPlant(Name)
    if AutoCollectAll then
        return true
    end

    if #SelectedPlants == 0 then
        return false
    end

    local LowerName = Name:lower()

    for _, Plant in ipairs(SelectedPlants) do
        if LowerName:find(
            Plant:lower(),
            1,
            true
        ) then
            return true
        end
    end

    return false
end

local function matchesMutation(Name)
    if not MutationOnly then
        return true
    end

    local LowerName = Name:lower()

    if #SelectedMutations > 0 then
        for _, Mutation in ipairs(SelectedMutations) do
            if LowerName:find(
                Mutation:lower(),
                1,
                true
            ) then
                return true
            end
        end

        return false
    end

    for _, Mutation in ipairs(ALL_MUTATIONS) do
        if LowerName:find(
            Mutation:lower(),
            1,
            true
        ) then
            return true
        end
    end

    return false
end

--============================================================
-- OBJECT POSITION
--============================================================

local function getObjectPosition(Object)
    if not Object then
        return nil
    end

    if Object:IsA("BasePart") then
        return Object.Position
    end

    if Object:IsA("Model") then
        if Object.PrimaryPart then
            return Object.PrimaryPart.Position
        end

        return Object:GetPivot().Position
    end

    return nil
end

--============================================================
-- FARM
--============================================================

local function getFarm()
    return Workspace:FindFirstChild("Farm", true)
end

--============================================================
-- COLLECT REMOTE
--============================================================

-- This should point to a RemoteEvent belonging to YOUR game.
-- The server should validate ownership, distance, item state,
-- cooldowns, and whether the plant can actually be collected.

local function getCollectRemote()
    local GameEvents = ReplicatedStorage:FindFirstChild("GameEvents")

    if not GameEvents then
        return nil
    end

    local Crops = GameEvents:FindFirstChild("Crops")

    if not Crops then
        return nil
    end

    local Collect = Crops:FindFirstChild("Collect")

    if Collect and Collect:IsA("RemoteEvent") then
        return Collect
    end

    return nil
end

--============================================================
-- FIND NEARBY PLANTS
--============================================================

local function getNearbyPlants()
    local Results = {}

    local RootPart = getRootPart()

    if not RootPart then
        return Results
    end

    local Farm = getFarm()

    if not Farm then
        return Results
    end

    local Origin = RootPart.Position
    local Seen = {}

    for _, Object in ipairs(Farm:GetDescendants()) do
        if Object:IsA("Model") and not Seen[Object] then
            Seen[Object] = true

            local Name = Object.Name

            if matchesPlant(Name)
                and matchesMutation(Name) then

                local Position =
                    getObjectPosition(Object)

                if Position then
                    local Distance =
                        (Position - Origin).Magnitude

                    if Distance <= CollectionRadius then
                        table.insert(
                            Results,
                            Object
                        )
                    end
                end
            end
        end
    end

    return Results
end

--============================================================
-- COLLECT ONE PLANT
--============================================================

local function collectPlant(Plant)
    if not Plant then
        return false
    end

    if not Plant.Parent then
        return false
    end

    local CollectRemote = getCollectRemote()

    if not CollectRemote then
        return false
    end

    local Success = pcall(function()
        -- Match this argument format to YOUR server API.
        CollectRemote:FireServer({
            Plant
        })
    end)

    return Success
end

--============================================================
-- AUTO COLLECT LOOP
--============================================================

local function startAutoCollect()
    if CollectLoopRunning then
        return
    end

    CollectLoopRunning = true

    task.spawn(function()
        while AutoCollectEnabled do
            local Plants = getNearbyPlants()

            for _, Plant in ipairs(Plants) do
                if not AutoCollectEnabled then
                    break
                end

                if Plant and Plant.Parent then
                    collectPlant(Plant)
                end

                task.wait(
                    math.max(
                        CollectCooldown,
                        0.01
                    )
                )
            end

            task.wait(0.2)
        end

        CollectLoopRunning = false
    end)
end

local function stopAutoCollect()
    AutoCollectEnabled = false
end

local function setAutoCollect(Value, AllMode)
    AutoCollectEnabled = Value
    AutoCollectAll = AllMode

    if Value then
        startAutoCollect()
    end
end

