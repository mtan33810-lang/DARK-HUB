AutomaticallyTab:CreateSection("Specific Selection")

local CropDropdown

AutomaticallyTab:CreateInput({
    Name = "🔍 Search & Select Plant",
    PlaceholderText = "Type plant name (e.g. Apple, Carrot)",
    RemoveTextAfterFocusLost = false,
    Callback = function(Text)
        if Text == "" then return end
        
        local textLower = Text:lower()
        local matches = {}
        
        for _, plant in ipairs(ALL_COLLECTIBLES) do
            if plant:lower():find(textLower, 1, true) then
                table.insert(matches, plant)
            end
        end
        
        if #matches > 0 then
            for _, match in ipairs(matches) do
                local alreadySelected = false
                for _, sel in ipairs(selectedFruits) do
                    if sel:lower() == match:lower() then
                        alreadySelected = true
                        break
                    end
                end
                
                if not alreadySelected then
                    table.insert(selectedFruits, match)
                end
            end
            
            if CropDropdown then
                CropDropdown:Set(selectedFruits)
            end
            
            Rayfield:Notify({
                Title = "Plant Added",
                Content = "Added: " .. table.concat(matches, ", "),
                Duration = 3,
            })
        else
            Rayfield:Notify({
                Title = "Not Found",
                Content = "No plants matching '" .. Text .. "'",
                Duration = 3,
            })
        end
    end,
})

CropDropdown = AutomaticallyTab:CreateDropdown({
    Name = "Select Specific Crops (Manual List)",
    Options = ALL_COLLECTIBLES,
    CurrentOption = {},
    MultipleOptions = true,
    Callback = function(Options)
