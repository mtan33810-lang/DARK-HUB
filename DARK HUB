local autoCollectEnabled = false
local autoCollectAllEnabled = false
local selectedFruits = {}
local collectionRadius = 100
local collectCooldown = 0.2

local CollectRemote = ReplicatedStorage:FindFirstChild("GameEvents") 
    and ReplicatedStorage.GameEvents:FindFirstChild("Crops") 
    and ReplicatedStorage.GameEvents.Crops:FindFirstChild("Collect")

local ALL_COLLECTIBLES = {
    "Apple", "Coconut", "Banana", "Mango", "Dragon Fruit", "Sugar Apple", "Alien Apple", "Elder Strawberry",
    "Carrot", "Tomato", "Corn", "Pumpkin", "Watermelon", "Bamboo", "Cactus", "Pepper", "Romanesco",
    "Strawberry", "Blueberry", "Grape", "Moongrain Meadow",
    "Buttercup", "Orange Tulip", "Daffodil", "Sunflower", "Burning Bud", "Ember Lily", "Crimson Thorn", "Octobloom",
    "Mushroom", "Cacao", "Giant Pinecone", "Zebrazinkle"
}

local function getHRP()
    local char = player.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function collectItem(obj)
    if not CollectRemote then return false end
    return pcall(function()
        CollectRemote:FireServer({ obj })
    end)
end

local function getHarvestableItems()
    local items = {}
    local hrp = getHRP()
    
    local function processInstance(obj)
        for _, name in ipairs(ALL_COLLECTIBLES) do
            if obj.Name:lower():find(name:lower(), 1, true) then
                local pos = nil
                if obj:IsA("BasePart") then
                    pos = obj.Position
                elseif obj:IsA("Model") and obj.PrimaryPart then
                    pos = obj.PrimaryPart.Position
                end

                local dist = (pos and hrp) and (pos - hrp.Position).Magnitude or 0

                table.insert(items, {
                    Object = obj,
                    Name = name,
                    Distance = dist
                })
                break
            end
        end
    end

    for _, obj in ipairs(Workspace:GetDescendants()) do
        processInstance(obj)
    end

    if getnilinstances then
        for _, obj in ipairs(getnilinstances()) do
            processInstance(obj)
        end
    end

    return items
end

local function startCollectionLoop()
    task.spawn(function()
        while autoCollectEnabled do
            local items = getHarvestableItems()
            
            for _, item in ipairs(items) do
                if not autoCollectEnabled then break end
                if item.Distance > collectionRadius then continue end

                if not autoCollectAllEnabled then
                    local selected = false
                    for _, name in ipairs(selectedFruits) do
                        if item.Name:lower() == name:lower() then
                            selected = true
                            break
                        end
                    end
                    if not selected then continue end
                end

                collectItem(item.Object)
                task.wait(collectCooldown)
            end
            
            task.wait(0.5)
        end
    end)
end

