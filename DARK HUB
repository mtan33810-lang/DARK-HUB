--============================================================
-- SELECTED PLANTS
--============================================================

AutomaticallyTab:CreateToggle({
    Name = "Auto Collect Selected Plants",
    CurrentValue = false,
    Flag = "AutoCollectSelected",

    Callback = function(Value)
        if Value then
            if #SelectedPlants == 0 then
                Rayfield:Notify({
                    Title = "No Plants Selected",
                    Content = "Select at least one plant.",
                    Duration = 3
                })

                return
            end

            setAutoCollect(true, false)

            Rayfield:Notify({
                Title = "Auto Collect",
                Content = "Collecting selected plants.",
                Duration = 3
            })
        else
            stopAutoCollect()

            Rayfield:Notify({
                Title = "Auto Collect",
                Content = "Stopped.",
                Duration = 2
            })
        end
    end
})

--============================================================
-- CLEAR FILTERS
--============================================================

AutomaticallyTab:CreateButton({
    Name = "Clear All Selections",

    Callback = function()
        SelectedPlants = {}
        SelectedMutations = {}

        if PlantDropdown then
            PlantDropdown:Set({})
        end

        if MutationDropdown then
            MutationDropdown:Set({})
        end

        Rayfield:Notify({
            Title = "Filters",
            Content = "Selections cleared.",
            Duration = 2
        })
    end
})

